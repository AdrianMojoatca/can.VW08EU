@@*****************************************************************************
@@	febuary 24 2012    Version 1.57
@@				modified:
@@                       
@@					                   			FN_OBD_CAN_ENABLE			at  0BBh to enable  OBD_CAN librairie activity 
@@										FN_OBD_CAN_DISABLE			at  0BCh to disable OBD_CAN librairie activity
@@
@@
@@      July	19 2011    Version 1.56
@@				Modifed:
@@										SET_DTC_CODE				at 035h return 3 bytes instand of 4 bytes
@@										AL_ALARM_ALERT				at 0B9h duplicated as FN_ALARM_TRIGGERED
@@
@@      July	15 2011    Version 1.55
@@				Modified:
@@										FN_START_STOP_REM			at 099h	rename to FN_START_REM
@@										FN_START_REM				at 09Bh rename to FN_START_ONLY
@@
@@		July	11 2011	   Version 1.54
@@				Modified:
@@										SET_EXTENDED_STATUS 		at 075h  Bit2 of Byte3 in SET_EXTENDED_STATUS defined as bit of engine running state change
@@																             Bit set means bit 6 of Byte 1 has changed value
@@
@@		June	28 2011	   Version 1.53
@@				Adding code:
@@										REQ_VIN						at 017h request the entire VIN data
@@										AL_NEW_DTC_CODE				at 018h alert the new DTC code presents					
@@
@@				Modified:
@@										REQ_MIL/SET_MIL renamed to REQ_ODO/SET_ODO
@@
@@		June	20 2011	   Version 1.51
@@				Adding code:
@@										FN_EXTEND_RUNTIME	   		at 027h  command to extend runtime. No effect if not in runtime mode
@@										REQ_PROTOCOL_VER	   		at 049h  request protocol version
@@										SET_PROTOCOL_VER	   		at 04Ah  return protocol version
@@										AL_QUERY			   		at 04Bh  query alert status
@@										REQ_MODULE_INFO		   		at 050h	 request module information
@@										SET_PLATFORM_ID		   		at 051h	 return platform ID
@@										SET_HW_VERSION		   		at 052h  return hardware version
@@										SET_FW_ID			   		at 053h	 return firmware ID
@@										SET_FW_VERSION		   		at 055h	 return firmware version
@@										REQ_EXTENDED_STATUS_SUPPORT	at 056h  request extended support status
@@										SET_EXTENDED_STATUS_SUPPORT	at 057h  return extended support status
@@										REQ_RUNTIME			   		at 059h  request remaining runtime
@@										SET_RUNTIME			   		at 05Ah	 return remaining runtime
@@										AL_ALERT_STATUS				at 05Bh  return alert status
@@										AL_FAILED_TO_UNLOCK			at 05Ch  return alert of failed to unlock
@@										AL_FAILED_TO_START			at 05Dh  return alert of failed to start
@@										AL_FAILED_TO_STOP			at 05Eh  return alert of failed to stop
@@										AL_FAILED_TO_LOCK			at 05Fh  return alert of failed to lock
@@										AL_ALERT_CLEAR				at 070h  function to clear all alert
@@										SET_EXTENDED_STATUS			at 075h  return extended status
@@										REQ_2WAY_STATUS				at 07Eh  request 2-way status
@@										REQ_EXTENDED_STATUS			at 07Fh  request extended status
@@										FN_START_REM				at 09Bh  function to start engine only
@@
@@				Modified:
@@										AL_EIPS_SHUTDOWN_FAIL		at 073h  duplicated as SET_EIPS_SHUTDOWN_FAIL
@@										AL_EIPS_ALERT				at 0D2h  duplicated as SET_EIPS_ALERT
@@										AL_EIPS_SHUTDOWN			at 0D3h  duplicated as SET_EIPS_SHUTDOWN
@@
@@
@@      March    8 2011    Version 1.13
@@              Adding code:       
@@                                      SET_EIPS_SHUTDOWN_FAIL at 073h  send command to notify the user the car still running after shutdown 
@@                                      REQ_DTC_CODE           at 003h  request current dtc code
@@                                      SET_DTC_CODE           at 035h  return 4 bytes (byte 1 is counter byte 2 to 4 is dtc code)
@@
@@
@@      March    2  2011   Version 1.12
@@              Adding code:       
@@                                      SET_EIPS_ALERT    at 0D2h. SEND ALERT COMMAND TO NOTIFY THE USER THE CAR RUNNING WITHOUT SMARTKEY (EVERY XMIN)
@@                                      SET_EIPS_SHUTDOWN at 0D3h. SEND SHUTDOWN COMMAND TO NOTIFY THE USER THE CAR SHUTDOWN AFTER XMIN WITHOUT SMARTKEY
@@
@@      December 16 2010   Version 1.11
@@              Adding code:       
@@                                      FN_VALET_TOGGLE at 0C7h. Each time this function is seen, the valet has been toggle through RF remote or Smart Start or ...
@@    
@@      September 14 2010  Version 1.10
@@              Adding code:       
@@                                      REQ_DTC         at 004h request number of dtc code
@@                                      REQ_CLR_DTC     at 006h clear dtc code
@@                                      REQ_FUEL_LEVEL  at 007h request fuel level (0% to 100%)
@@                                      REQ_MIL         at 00Ah request millage (KM)
@@                                      REQ_BAT_VOLT    at 00Bh request battery voltage 0 to 15.94
@@                                      REQ_TPMS        at 00Eh request TPMS state
@@
@@                                      REQ_VIN_1       at 011h request vin digit 1  to 2
@@                                      REQ_VIN_2       at 012h request vin digit 3  to 5
@@                                      REQ_VIN_3       at 013h request vin digit 6  to 8 
@@                                      REQ_VIN_4       at 014h request vin digit 9  to 11
@@                                      REQ_VIN_5       at 015h request vin digit 12 to 14
@@                                      REQ_VIN_6       at 016h request vin digit 15 to 17
@@
@@                                      SET_VIN_1       at 021h return 2 bytes digit 1  to 2  
@@                                      SET_VIN_2       at 022h return 3 bytes digit 3  to 5  
@@                                      SET_VIN_3       at 023h return 3 bytes digit 6  to 8  
@@                                      SET_VIN_4       at 024h return 3 bytes digit 9  to 11 
@@                                      SET_VIN_5       at 025h return 3 bytes digit 12 to 14 
@@                                      SET_VIN_6       at 026h return 3 bytes digit 15 to 17
@@ 
@@                                      SET_DTC         at 034h return 1 byte  (number of dtc code store)
@@                                      SET_DTC_CLR     at 036h return 1 byte  (1 = success : 0 = false) 
@@                                      SET_FUEL_LEVEL  at 037h return 1 byte  (0 = 0% : 100 = 100%)
@@                                      SET_MIL         at 03Ah return 3 bytes (0 to 999999)
@@                                      SET_BAT_VOLT    at 03Bh return 1 byte  (0 to 15.94 Volts) value/16 ex: 196/16 = 12.25V
@@                                      SET_TPMS        at 03Eh return 1 byte  (bit 7 -> 1 = on : 0 = off)
@@                                                                     
@@
@@      April 27th 2010     Version 1.09
@@              Adding code:            FN_ALARM_TRIGGERED at 0B9h (mostly for Smart Start signaling)
@@
@@      July 29th 2009     Version 1.08
@@              Adding code:            FN_CAR_IGN_ON at 0C3h and FN_CAR_IGN_OFF at 043h
@@
@@      August 25th 2008   Version 1.06
@@              Adding code:            FN_CAR_FINDER at 0B8h
@@                                      SET_HANDBRAKE_ON at 0CFh and SET_HANDBRAKE_OFF at 04Fh
@@                          Also add HANDBRAKE in REQ_INPUT_STATUS BIT7
@@      Updating Code:      Remove reserved code 043h, 045h, 046h, 050h, 052h
@@
@@      July 18th 2008     Version 1.051
@@              Adding code:            Reserved code 031h, 032h, 033h
@@
@@      Nov 14th 2007      Version 1.05
@@              Renaming Code:          Change SET_KEYLESS_UNLOCK (0DDH) to SET_KEYLESS_DISARM(0DDH) and change comment
@@                                                      Change SET_KEYLESS_LOCK (0DEH) to SET_KEYLESS_ARM(0DEH) and change comment
@@              Updating Code:          Add code SET_KEYLESS_UNLOCK (0D4H) and add comment
@@                                                      Add code SET_KEYLESS_LOCK (0D5H) and add comment
@@
@:FULL
@@      April 4th 2007  
@@              Updating Code:          Change Name of  FN_A8 to FN_SHORT_TRUNK, FN_A9 to FN_LONG_START,
@@                                                      RESERVE_09 to FN_READ_EEPROM, RESERVE_F6 to FN_WRITE_EEPROM
@@              Adding Code:            CHAR_C for programming Memory Card
@@              Updating Comment:       CHAR_T FOR TESTER, CHAR_P FOR BOOTLOADER
@@      
@;                              
@@      Jan 3rd 2007    
@@              Adding Code:            Add Keyless Panic 0D7h
@@              Adding Code:            Add Keyless Aux3 0D6h
@@              Updating Code:          Change Name of  SET_KEYLESS_4TH_BUTTON(0DCH) WITH SET_KEYLESS_AUX4(0DCH)
@@
@@      Dec 21st 2006
@@              Updating Code:          Add reserve for Code 0D1H
@@
@@      Dec 14th 2006
@@              Updating Code:          Add reserve for Code 0A9H
@@
@@      Dec 6th 2006    
@@              Updating Code:          Add reserve for Code 0A8H
@@
@:FULL
@@      Oct 30th 2006   
@@              Updating Code:          Updating temperature format min -127 to +127 in SET_2WAY_STATUS 
@@
@@      Sept 19th 2006  
@@              Updating code:          Adding 1 byte in SET_2WAY_STATUS(0D0H)
@@                                                      move byte3 to byte4 for adding 8 spares bit
@@                                                      Move bit7 in byte2(MINUS) to bit7 in byte4
@@                                                      Adding °F/°C to byte2 bit7
@@                                                      Changing temperature range +127 to -127 
@@
@@      Sept 14th 2006  
@@              Adding code:            bit spare byte #2 of SET_2WAY_STATUS(0D0H) to TIME
@@              Updating Comment:       in description of byte#2 & byte #3 of SET_2WAY_STATUS(0D0H)
@@
@;
@@      August 28th 2006        
@@              Adding code:            RESERVE_09 & RESERVE_F6 this code is reserve for a Manufacturer
@@
@@      August 8th 2006 
@@              Adding code:            Add reserve for Code 0D0H
@@                                                      SET_KEYLESS_AUX1 for left/right slide
@@                                                      SET_KEYLESS_AUX2 for left/right slide
@@
@@      July 16th 2006
@:FULL  
@@              Adding code:            Char_X for XTR module
@;
@@              Updating Comment:       modify comment in 0F0H
@@
@@      May 15th 2006   
@@              Adding code:            REQ. vehicule speed(00Dh), send Vehicule Speed (0FAh)+ 1 byte, park/neutral sw. active(077h=No & 0F7h = yes),
@:FULL
@@                                                      stop from aftermarket remote (019h) & start from aftermarket remote (099h)
@;
@@                                                      from keyless:start(0DAh), stop(0DBh), trunk(0DFh) & 4TH BUTTON(0DCh) OR ANY OTHER BUTTON
@@              Updating code:          adding bit(6) for park/neutral SW. in STATUS(0FEh)
@@                                                      FN_PARK_ON TO FN_PARKING_ON , FN_PARK_OFF TO FN_PARKING_OFF (to eliminate confusion between PARK/NEUTRAL and PARKING functions)
@@              Updating Code:          engine temp(00Ah) to (005h)
@:FULL
@@              deleting code:          (009H) read remote start option & (0F6h) send remote start option
@;
@@
@@******************************************************************************/

@CFN_00                                 @A 0x00 
@CREQ_INPUT_STATUS                      @A 0x01 @@REQUEST STATUS FOR DRIVER DOOR,OTHER DOOR,TRUNK,HOOD & BRAKE 
@CFN_02                                 @A 0x02 @@RESERVED
@CREQ_DTC_CODE                          @A 0x03 @@REQUEST CURRENT DTC CODE
@CREQ_DTC                               @A 0x04 @@REQUEST NUMBER OF DTC CODE
@CREQ_ENG_TEMP                          @A 0x05 @@REQUEST ENGINE COOLANT TEMPERATURE
@CREQ_CLR_DTC                           @A 0x06 @@CLEAR DTC CODE
@CREQ_FUEL_LEVEL                        @A 0x07 @@REQUEST FUEL LEVEL (0% TO 100%)
@CFN_GWR_OFF                            @A 0x08 @@GWR OFF
@:FULL
@CFN_READ_EEPROM                        @A 0x09 @@RESERVED 
@;
@:STRIPPED
@CRESERVED_09                           @A 0x09 @@RESERVED 
@;
@CREQ_ODO                               @A 0x0A @@REQUEST MILLAGE (KM)               
@CREQ_BAT_VOLT                          @A 0x0B @@REQUEST BATTERY VOLTAGE 0 TO 15.94 
@CREQ_RPM                               @A 0x0C @@REQUEST RPM 
@CREQ_SPEED                             @A 0x0D @@REQUEST VEHICULE SPEED
@CREQ_TPMS                              @A 0x0E @@REQUEST TPMS STATE
@CREQ_INT_TEMP                          @A 0x0F @@REQUEST INTAKE AIR TEMPERATURE(OUTSIDE TEMP)
@CFN_PANIC_REM1_OFF                     @A 0x10 @@FUNCTION PANIC OFF FROM REMOTE 1
@CREQ_VIN_1                             @A 0x11 @@REQUEST VIN DIGIT 1  TO 2     
@CREQ_VIN_2                             @A 0x12 @@REQUEST VIN DIGIT 3  TO 5     
@CREQ_VIN_3                             @A 0x13 @@REQUEST VIN DIGIT 6  TO 8     
@CREQ_VIN_4                             @A 0x14 @@REQUEST VIN DIGIT 9  TO 11    
@CREQ_VIN_5                             @A 0x15 @@REQUEST VIN DIGIT 12 TO 14    
@CREQ_VIN_6                             @A 0x16 @@REQUEST VIN DIGIT 15 TO 17    
@CREQ_VIN                               @A 0x17	@@REQ THE ENTIRE VIN DATA
@CAL_NEW_DTC_CODE                       @A 0x18 @@ALERT THE NEW DTC CODE PRESENTS
@:FULL  
@CFN_STOP_REM                           @A 0x19 @@FUNCTION STOP FROM REMOTE
@;
@:STRIPPED
@CRESERVED_19                           @A 0x19 @@RESERVED
@;
@CFN_1A                                 @A 0x1A @@RESERVED
@CFN_1B                                 @A 0x1B @@RESERVED
@CFN_1C                                 @A 0x1C @@RESERVED
@CFN_1D                                 @A 0x1D @@RESERVED
@CFN_1E                                 @A 0x1E @@RESERVED
@CFN_1F                                 @A 0x1F @@RESERVED
@CFN_PANIC_REM2_OFF                     @A 0x20 @@FUNCTION PANIC OFF FROM REMOTE 2      
@CSET_VIN_1                             @A 0x21 @@RETURN 2 BYTES DIGIT 1  TO 2   
@CSET_VIN_2                             @A 0x22 @@RETURN 3 BYTES DIGIT 3  TO 5   
@CSET_VIN_3                             @A 0x23 @@RETURN 3 BYTES DIGIT 6  TO 8   
@CSET_VIN_4                             @A 0x24 @@RETURN 3 BYTES DIGIT 9  TO 11  
@CSET_VIN_5                             @A 0x25 @@RETURN 3 BYTES DIGIT 12 TO 14  
@CSET_VIN_6                             @A 0x26 @@RETURN 3 BYTES DIGIT 15 TO 17  
@CFN_EXTEND_RUNTIME                     @A 0x27 @@FUNCTION EXTEND RUNTIME
@CFN_28                                 @A 0x28 @@RESERVED
@CFN_29                                 @A 0x29 @@RESERVED
@CFN_2A                                 @A 0x2A @@RESERVED
@CFN_2B                                 @A 0x2B @@RESERVED
@CFN_2C                                 @A 0x2C @@RESERVED
@CFN_2D                                 @A 0x2D @@RESERVED
@CFN_2E                                 @A 0x2E @@RESERVED
@CFN_2F                                 @A 0x2F @@RESERVED
@CFN_PANIC_REM3_OFF                     @A 0x30 @@FUNCTION PANIC OFF FROM REMOTE 3
@:FULL  
@CFN_31                                 @A 0x31 @@RESERVED FOR ONE BYTE DATA TRANSMISSION
@CFN_32                                 @A 0x32 @@RESERVED FOR TWO BYTES DATA TRANSMISSION 
@CFN_33                                 @A 0x33 @@RESERVED FOR THREE BYTES DATA TRANSMISSION
@;
@:STRIPPED
@CRESERVED_31                           @A 0x31 @@RESERVED
@CRESERVED_32                           @A 0x32 @@RESERVED
@CRESERVED_33                           @A 0x33 @@RESERVED
@;
@CSET_DTC                               @A 0x34 @@RETURN 1 BYTE  (NUMBER OF DTC CODE STORE)
@CSET_DTC_CODE                          @A 0x35 @@RETURN 3 BYTES (BYTE1 =  # OF CODE STORE) (BYTE 2 = BIT7:6 INDICATES LETTER P,C,U..., BIT5:4 FIRST DIGITAL OF DTC ) 
@@                                                   BIT3:0 OF BYTE 2 AND BYTE 3 INDICATE THREE HEX CHARACTERS. EX: 0x12 0x01 0x26 (12"P"0126) = CODE 1 OF 2 IS P0126
@CSET_DTC_CLR                           @A 0x36 @@RETURN 1 BYTE  (1 = SUCCESS : 0 = FALSE)
@CSET_FUEL_LEVEL                        @A 0x37 @@RETURN 1 BYTE  (0 = 0% : 100 = 100%)        
@CFN_38                                 @A 0x38 @@RESERVED
@CFN_39                                 @A 0x39 @@RESERVED
@CSET_ODO                               @A 0x3A @@RETURN 3 BYTES (0 TO 999999)
@CSET_BAT_VOLT                          @A 0x3B @@RETURN 1 BYTE  (0 TO 15.94 VOLTS) VALUE/16 EX: 196/16 = 12.25V
@CFN_3C                                 @A 0x3C @@RESERVED
@CFN_3D                                 @A 0x3D @@RESERVED
@CSET_TPMS                              @A 0x3E @@RETURN 1 BYTE  (BIT 7-> 1 = ON : 0 = OFF)
@CFN_3F                                 @A 0x3F @@RESERVED
@CFN_DOME_OFF                           @A 0x40 @@FUNCTION DOME OFF FROM REMOTE STARTER
@CFN_ACC_OFF                            @A 0x41 @@FUNCTION ACC OFF FROM REMOTE STARTER
@CFN_IGN_OFF                            @A 0x42 @@FUNCTION IGNITION OFF FROM REMOTE STARTER
@CFN_CAR_IGN_OFF                        @A 0x43 @@FUNCTION CAR IGNITION OFF DETECTED BY IGNITION SENSE INPUT OF REMOTE STARTER
@CFN_START_OFF                          @A 0x44 @@FUNCTION STARTER OFF FROM REMOTE STARTER
@CFN_45                                 @A 0x45 @@RESERVED
@CFN_46                                 @A 0x46 @@RESERVED
@CFN_47                                 @A 0x47 @@RESERVED
@CFN_PARKING_OFF                        @A 0x48 @@FUNCTION PARKING OFF FROM REMOTE STARTER
@CREQ_PROTOCOL_VER                      @A 0x49 @@REQUEST D2D PROTOCOL VERSION
@CSET_PROTOCOL_VER                      @A 0x4A @@RETURN D2D PROTOCOL VERSION
@CAL_QUERY                              @A 0x4B @@QUERY ALERT STATUS
@CFN_4C                                 @A 0x4C @@RESERVED
@CFN_4D                                 @A 0x4D @@RESERVED
@CFN_4E                                 @A 0x4E @@RESERVED
@CSET_HANDBRAKE_OFF                     @A 0x4F @@HANDBRAKE IS DISENGAGED
@CREQ_MODULE_INFO                       @A 0x50 @@REQUEST MODULE INFORMATION
@CSET_PLATFORM_ID                       @A 0x51 @@RETURN PLATFORM ID
@CSET_HW_VERSION                        @A 0x52 @@RETURN HARDWARE VERSION
@CSET_FW_ID                             @A 0x53 @@RETURN FIRMWARE ID
@:FULL
@CCHAR_T                                @A 0x54 @@RESERVED FOR TESTER
@;
@:STRIPPED
@CRESERVED_54                           @A 0x54 @@RESERVED
@;
@CSET_FW_VERSION                        @A 0x55 @@RETURN FIRMWARE VERSION
@CREQ_EXTENDED_STATUS_SUPPORT           @A 0x56 @@REQUEST EXTENDED STATUS SUPPORT
@CSET_EXTENDED_STATUS_SUPPORT           @A 0x57 @@RETURN EXTENDED STATUS SUPPORT
@:FULL
@CCHAR_X                                @A 0x58 @@RESERVED FOR XTR ACTIVATION
@;
@:STRIPPED
@CRESERVED_58                           @A 0x58 @@RESERVED
@;
@CREQ_RUNTIME                           @A 0x59 @@REQUEST REMAINING ENGINE RUNTIME
@CSET_RUNTIME                           @A 0x5A @@RETURN REMAINING ENGINE RUNTIME
@CAL_ALERT_STATUS                       @A 0x5B @@RETURN ALERT STATUS
@CAL_FAILED_TO_UNLOCK                   @A 0x5C @@RETURN ALERT OF FAILED TO UNLOCK
@CAL_FAILED_TO_START                    @A 0x5D @@RETURN ALERT OF FAILED TO START
@CAL_FAILED_TO_STOP                     @A 0x5E @@RETURN ALERT OF FAILED TO STOP
@CAL_FAILED_TO_LOCK                     @A 0x5F @@RETURN ALERT OF FAILED TO LOCK
@CFN_60                                 @A 0x60 @@RESERVED FOR ENCRYPTION       
@CFN_61                                 @A 0x61 @@RESERVED FOR ENCRYPTION
@CFN_62                                 @A 0x62 @@RESERVED FOR ENCRYPTION       
@CFN_63                                 @A 0x63 @@RESERVED FOR ENCRYPTION       
@CFN_64                                 @A 0x64 @@RESERVED FOR ENCRYPTION       
@CFN_65                                 @A 0x65 @@RESERVED FOR ENCRYPTION       
@CFN_66                                 @A 0x66 @@RESERVED FOR ENCRYPTION       
@CFN_67                                 @A 0x67 @@RESERVED FOR ENCRYPTION       
@CFN_68                                 @A 0x68 @@RESERVED FOR ENCRYPTION       
@CFN_69                                 @A 0x69 @@RESERVED FOR ENCRYPTION       
@CFN_6A                                 @A 0x6A @@RESERVED FOR ENCRYPTION       
@CFN_6B                                 @A 0x6B @@RESERVED FOR ENCRYPTION       
@CFN_6C                                 @A 0x6C @@RESERVED FOR ENCRYPTION       
@CFN_6D                                 @A 0x6D @@RESERVED FOR ENCRYPTION       
@CFN_6E                                 @A 0x6E @@RESERVED FOR ENCRYPTION       
@CFN_6F                                 @A 0x6F @@RESERVED FOR ENCRYPTION       
@CAL_ALERT_CLEAR                        @A 0x70 @@CLEAR ALL PREVIOUS ALERT        
@CSET_HOOD_CLOSE                        @A 0x71 @@SEND HOOD CLOSE TO REMOTE STARTER
@CSET_TRUNK_CLOSE                       @A 0x72 @@SEND TRUNK CLOSE TO REMOTE STARTER
@CAL_EIPS_SHUTDOWN_FAIL                 @A 0x73 @@SEND NOTIFICATION TO USER THATS THE CAR STILL RUNNING AFTER SHUTDOWN
@CSET_EIPS_SHUTDOWN_FAIL                @A AL_EIPS_SHUTDOWN_FAIL @@duplicated
@CSET_DRIVER_CLOSE                      @A 0x74 @@SEND DRIVER CLOSE TO REMOTE STARTER
@CSET_EXTENDED_STATUS                   @A 0x75 @@RETURN UPDATED STATUS OF VEHICLE
@@                              BYTE 1:
@@                                      BIT0 = LOCK                     (1: LOCK)
@@                                      BIT1 = ARMED                    (1: ARMED)
@@                                      BIT2 = IGNITION         		(1: ON)
@@                                      BIT3 = PARKING  LIGHT			(1: ON)
@@                                      BIT4 = SIREN 					(1: ON)
@@                                      BIT5 = VALET MODE       		(1: ACTIVATED)
@@                                      BIT6 = START SUCCESSFULLY		(1: ENGINE IS RUNNING)
@@                                      BIT7 = PAGING,CAR FIND OR PANIC (1: ON)
@@                              BYTE 2:
@@                                      BIT0 = DOOR TRIGGER             (1: OPEN)
@@                                      BIT1 = TRUNK TRIGGER            (1: OPEN)
@@                                      BIT2 = HOOD TRIGGER             (1: OPEN)
@@                                      BIT3 = WARN AWAY        		(1: TRIGGERED)
@@                                      BIT4 = SHOCK TRIGGER    		(1: TRIGGERED)
@@                                      BIT5 = READY MODE				(1: NOT READY)
@@                                      BIT6 = RESERVED
@@                                      BIT7 = RESERVED
@@                              BYTE 3:
@@                                      BIT0 = DTC CODE PRESET				(1: YES)
@@                                      BIT1 = ALERT CONDITION				(1: YES)
@@                                      BIT2 = ENGINE RUNNING STATE CHANGE	(1: BIT6 OF BYTE1 VALUE CHANGED)
@@                                      BIT3 = RESERVED
@@                                      BIT4 = RESERVED
@@                                      BIT5 = RESERVED
@@                                      BIT6 = RESERVED
@@                                      BIT7 = RESRVERD
@@
@CFN_76                                 @A 0x76 @@RESERVED
@CSET_PRK_NTRL_NOT_ACTIVE               @A 0x77 @@SEND TRANSMISSION PARK/NEUTRAL SW ACTIVE = NO
@CSET_OTHER_CLOSE                       @A 0x78 @@SEND OTHER DOOR CLOSE TO REMOTE STARTER
@CSET_BRAKE_OFF                         @A 0x79 @@SEND BRAKE PEDAL RELASE TO REMOTE STARTER
@CFN_7A                                 @A 0x7A @@RESERVED
@CSET_GLOWPLUG_OFF                      @A 0x7B @@SEND GLOW PLUG OFF TO REMOTE STARTER
@CSET_KEY_OUT                           @A 0x7C @@SEND KEY OUT TO REMOTE STARTER
@CSET_IGN_OFF                           @A 0x7D @@SEND IGNITION OFF TO REMOTE STARTER
@CREQ_2WAY_STATUS                       @A 0x7E @@REQUEST UPDATED 2-WAY STATUS
@CREQ_EXTENDED_STATUS                   @A 0x7F @@REQUEST UPDATED STATUS OF VEHICLE
@CFN_80                                 @A 0x80 @@RESERVED
@CFN_ARM                                @A 0x81 @@FUNCTION ARM ONLY
@CFN_DISARM                             @A 0x82 @@FUNCTION DISARM ONLY
@CFN_83                                 @A 0x83 @@RESERVED
@CFN_84                                 @A 0x84 @@RESERVED
@CFN_85                                 @A 0x85 @@RESERVED
@CFN_86                                 @A 0x86 @@RESERVED
@CFN_87                                 @A 0x87 @@RESERVED
@CFN_GWR_ON                             @A 0x88 @@FUNCTION GROUND WHEN RUNNING ON
@CFN_89                                 @A 0x89 @@RESERVED
@CFN_8A                                 @A 0x8A @@RESERVED
@CFN_8B                                 @A 0x8B @@RESERVED
@CFN_8C                                 @A 0x8C @@RESERVED
@CFN_8D                                 @A 0x8D @@RESERVED
@CFN_8E                                 @A 0x8E @@RESERVED
@CFN_8F                                 @A 0x8F @@RESERVED
@CFN_PANIC_REM1_ON                      @A 0x90 @@FUNCTION PANIC ON FROM REMOTE 1
@CFN_LOCK_REM1_ON                       @A 0x91 @@FUNCTION LOCK ON FROM REMOTE 1
@CFN_UNLOCK_DR_REM1_ON                  @A 0x92 @@FUNCTION UNLOCK DRIVER ON FROM REMOTE 1
@CFN_AUX1_REM1_ON                       @A 0x93 @@FUNCTION AUX1 ON FROM REMOTE 1
@CFN_TRUNK_REM1_ON                      @A 0x94 @@FUNCTION TRUNK ON FROM REMOTE 1
@CFN_AUX2_REM1_ON                       @A 0x95 @@FUNCTION AUX2 ON FROM REMOTE 1
@CFN_AUX3_REM1_ON                       @A 0x96 @@FUNCTION AUX3 ON FROM REMOTE 1
@CFN_AUX4_REM1_ON                       @A 0x97 @@FUNCTION AUX4 ON FROM REMOTE 1
@CFN_CHIRP                              @A 0x98 @@FUNCTION CHIRP FROM REMOTE 1
@:FULL
@CFN_START_REM                          @A 0x99 @@FUNCTION START/STOP FROM REMOTE
