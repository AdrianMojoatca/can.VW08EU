@CSET_2WAY_STATUS                       @A 0xD0 @@SEND CODE TO RF INTERFACE + 4 BYTE LCD FUNCTION (ICON)
@@                              BYTE 1:
@@                                      BIT0 = LOCK                     (your vehicle doors are locked)
@@                                      BIT1 = ARMED                    (your vehicle is in armed mode)
@@                                      BIT2 = IGNITION         (ignition trigger)
@@                                      BIT3 = PARKING  LIGHT
@@                                      BIT4 = SIREN 
@@                                      BIT5 = VALET MODE       
@@                                      BIT6 = START SUCCESSFULLY
@@                                      BIT7 = PAGING,CAR FIND OR PANIC 
@@                              BYTE 2:
@@                                      BIT0 = DOOR TRIGGER             (Door is illegally open)
@@                                      BIT1 = TRUNK TRIGGER            (Trunk is illegally open)
@@                                      BIT2 = HOOD TRIGGER             (Hood is illegally open)
@@                                      BIT3 = WARN AWAY        
@@                                      BIT4 = SHOCK TRIGGER    
@@                                      BIT5 = TIME                     (Byte 4, bit 0 to 7, is use in time value, BCD, in minute)
@@                                      BIT6 = TEMPERATURE              (Byte 4, bit 0 to 6, is use in temperature value)
@@                                      BIT7 = °F / °C                  (0 = °F         1 = °C)
@@                              BYTE 3:
@@                                      BIT0 = SPARE
@@                                      BIT1 = SPARE
@@                                      BIT2 = SPARE
@@                                      BIT3 = SPARE
@@                                      BIT4 = SPARE
@@                                      BIT5 = SPARE
@@                                      BIT6 = SPARE
@@                                      BIT7 = SPARE
@@                                      
@@              IF TEMPERATURE BIT IS SET, BIT 7 IS FOR NEGATE OR MINUS AND BIT 0 TO 6 IS FOR TEMPERATURE VALUE (MIN = -127 MAX = +127)
@@                      EX:     11111111  = -127
@@                              ….
@@                              10000001  = -1
@@                              00000000  = 0
@@                              00000001  = +1
@@                              ….
@@                              01111111  = +127
@@
@@               IF TIME BIT IS SET, BIT 0 TO 7 IS BCD CODE OF TIME (MINUTE)
@@               ELSE 
@@               BIT0 TO BIT3 IS USE FOR TONE NUMBER(BINARY) AND BIT4 TO BIT7 IS USE TO CHIRP NUMBER(BINARY)
@@               0 IS USE FOR NO TONE AND 1 TO 15 IS USE FOR TONE NUMBER
@@               0 IS USE FOR NO CHIRP AND 1 TO 15 IS USE FOR CHIRP NUMBER
@@      
@@                              BYTE 4:
@@                                      BIT0 = TONE  (bit0)
@@                                      BIT1 = TONE  (bit1)
@@                                      BIT2 = TONE  (bit2)
@@                                      BIT3 = TONE  (bit3)
@@                                      BIT4 = CHIRP (bit0)
@@                                      BIT5 = CHIRP (bit1)
@@                                      BIT6 = CHIRP (bit2)
@@                                      BIT7 = CHIRP (bit3) if TEMPERATURE =1 then NEGATE OR MINUS ICON (Temperature below 0 celcius)
@@
@;
@:STRIPPED
@CRESERVED_D0                           @A 0xD0 @@RESERVED
@;
@CRESERVED_D1                           @A 0xD1 @@RESERVED
